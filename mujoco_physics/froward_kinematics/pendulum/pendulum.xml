<mujoco model="double_pendulum">
  <option timestep="0.002" integrator="RK4" gravity="0 0 -9.81"/>

  <worldbody>
    <light diffuse=".5 .5 .5" pos="0 0 3" dir="0 0 -1"/>
    <geom type="plane" size="1 1 0.1" rgba=".9 .9 .9 1"/>
    
    <body name="link1" pos="0 0 1">
      <joint name="joint1" pos="0 0 0" axis="0 1 0"/>
      <geom name="geom1" type="capsule" fromto="0 0 0 0 0 -0.5" size="0.03" rgba="1 0 0 1"/>
      
      <body name="link2" pos="0 0 -0.5">
        <joint name="joint2" pos="0 0 0" axis="0 1 0"/>
        <geom name="geom2" type="capsule" fromto="0 0 0 0 0 -0.5" size="0.03" rgba="0 1 0 1"/>
        <site name="tip" pos="0 0 -0.5" size="0.01"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="motor1" joint="joint1" gear="1" ctrllimited="true" ctrlrange="-10 10"/>
    <motor name="motor2" joint="joint2" gear="1" ctrllimited="true" ctrlrange="-10 10"/>
  </actuator>
</mujoco>